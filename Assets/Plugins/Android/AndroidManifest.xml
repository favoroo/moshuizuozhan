<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义主清单（Player Settings → Publishing Settings → Custom Main Manifest）。
  底稿 = Unity 自带模板 PlaybackEngines/AndroidPlayer/Apk/UnityManifest.xml，
  按本项目 androidApplicationEntry = Activity 只保留 UnityPlayerActivity 那一段。

  TapTap 渠道隐私合规（2026-11）：不再声明 REQUEST_INSTALL_PACKAGES / FileProvider。
  应用内更新改为「检查更新 → 浏览器打开 Release 页」，由 TapTap 商店或浏览器安装，
  避免与游戏功能无关的高危安装权限。若将来恢复应用内安装，需同时加回权限与 FileProvider。

  注意：本项目 AndroidApplicationEntry = Activity。若将来改成 GameActivity，
  这里必须换成 com.unity3d.player.UnityPlayerGameActivity，否则应用起不来。

  自检：菜单「P1/构建/12. 校验 Android 更新安装清单配置」
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 检查更新需要联网。显式声明，避免自定义主清单挤掉 Unity 默认注入的这条权限 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--Used when Application Entry is set to Activity, otherwise remove this activity block-->
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
                  android:theme="@style/UnityThemeSelector">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>
    </application>
</manifest>
