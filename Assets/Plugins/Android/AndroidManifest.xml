<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义主清单（Player Settings → Publishing Settings → Custom Main Manifest）。

  2026-11-03 TapTap 隐私复检（「同意前读取传感器列表」）：
  - 启动页改为原生 PrivacyActivity（com.p1studio.inkturfdemo.PrivacyActivity）。
    它只画隐私弹窗，用户点「同意并继续」之前不创建 UnityPlayer；
    同意后才显式拉起 UnityPlayerActivity，Unity3d 框架因此不会在同意前初始化。
  - UnityPlayerActivity 用 tools:node="replace" 覆盖 unityLibrary 的默认声明并去掉
    MAIN/LAUNCHER，保证桌面图标只有「隐私同意页」一个入口，不能绕过同意直接进游戏。
    其余属性（configChanges / launchMode / hardwareAccelerated 等）与 Unity 生成值一致。
  - 2026-11-04 反横屏修复：screenOrientation 用 "sensorLandscape" 而非 "landscape"——
    "landscape" 在 Android 语义里是锁死单一横屏方向、无视传感器，导致无法从左横屏翻到右横屏；
    "sensorLandscape" 跟随传感器在左右横屏间翻转且永不转竖屏，与 Player Settings 的
    allowedAutorotateToLandscapeLeft/Right（true）保持一致。两个 activity 都要改。
  - 应用内更新（GitHub / Gitee 全量包）：声明 REQUEST_INSTALL_PACKAGES + FileProvider，
    检查更新后可在应用内下载并调起系统安装器（UpdateManager.InAppInstallSupported = true）。
    TapTap 上架变体（P1_OFFLINE）不带联网/安装能力：这两项声明与 INTERNET 一起在
    Gradle 生成后由 AndroidPrivacyManifestPostprocessor 剥离（TapTap 曾把安装权限判为高危，v0.1.14 被拒）。

  注意：本项目 AndroidApplicationEntry = Activity。若将来改成 GameActivity，
  这里必须换成 com.unity3d.player.UnityPlayerGameActivity，否则应用起不来。

  自检：菜单「P1/构建/12. 校验 Android 更新安装清单配置」只覆盖更新安装链路；
  隐私启动页的产物校验见 tools/build_privacy_activity.sh。
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 检查更新需要联网。显式声明，避免自定义主清单挤掉 Unity 默认注入的这条权限 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 应用内更新安装：调起系统安装器需要「安装未知应用」权限（UpdateManager.InAppInstallSupported）。
         TapTap 上架变体（P1_OFFLINE）由 AndroidPrivacyManifestPostprocessor 在 Gradle 生成后剥离本条与下面的 provider -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- 安装 APK 走 content:// URI 共享，authority 必须与 UpdateManager.FileProviderAuthoritySuffix（.fileprovider）一致；
             路径表 res/xml/p1_update_paths.xml 与 androidx.core 实现类由 P1UpdateLib.androidlib 携带。
             provider 必须是 <application> 子节点，放在顶层会导致 Gradle manifest merge 失败 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/p1_update_paths" />
        </provider>

        <!-- 隐私同意启动页：唯一 LAUNCHER 入口，同意前不加载 Unity -->
        <activity
            android:name="com.p1studio.inkturfdemo.PrivacyActivity"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Unity 引擎页：只能由 PrivacyActivity 拉起；tools:node="replace" 抹掉库清单里的 LAUNCHER -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:theme="@style/UnityThemeSelector"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:hardwareAccelerated="false"
            android:resizeableActivity="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            tools:node="replace">
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
            <meta-data android:name="notch_support" android:value="true" />
            <layout
                android:minWidth="400px"
                android:minHeight="300px" />
        </activity>
    </application>
</manifest>
